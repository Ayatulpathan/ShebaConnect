# Application Config
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database Connection (Local MongoDB or Atlas M0)
MONGODB_URI=mongodb://127.0.0.1:27017/shebaconnect

# Authentication Secrets
JWT_ACCESS_SECRET=shebaconnect_jwt_access_secret_key_minimum_32_characters_for_dev
JWT_REFRESH_SECRET=shebaconnect_jwt_refresh_secret_key_minimum_32_characters_for_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
