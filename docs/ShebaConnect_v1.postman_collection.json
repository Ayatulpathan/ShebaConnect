{
  "info": {
    "_postman_id": "a9c7b39e-2f58-48b0-9831-25c77e089201",
    "name": "ShebaConnect API v1",
    "description": "Zero-Cost Local Service Booking Marketplace for Bangladesh (Dhaka launch).\nStrictly ৳0 / $0 Budget — Cash After Service Only.\n\nPhase 1: Health & System Diagnostics\nPhase 2: Authentication, RBAC & Address Management\nPhase 3: Marketplace Categories, Services, Search & Provider Listings",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "apiVersion",
      "value": "v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "serviceId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Health & Diagnostics",
      "item": [
        {
          "name": "Root Ping (/health)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Detailed Health Diagnostics (/api/v1/health)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Authentication",
      "item": [
        {
          "name": "Register Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", jsonData.data.accessToken);",
                  "    pm.collectionVariables.set(\"refreshToken\", jsonData.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tanvir Ahmed\",\n  \"email\": \"tanvir@example.com\",\n  \"phone\": \"01712345678\",\n  \"password\": \"SecurePass123\",\n  \"role\": \"CUSTOMER\",\n  \"preferredLanguage\": \"bn\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "auth", "register"]
            }
          }
        },
        {
          "name": "Login (Email or Phone)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", jsonData.data.accessToken);",
                  "    pm.collectionVariables.set(\"refreshToken\", jsonData.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"tanvir@example.com\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile (/auth/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "04. Categories (Phase 3)",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "categories"]
            }
          }
        },
        {
          "name": "Get Category by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/categories/ac-servicing",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "categories", "ac-servicing"]
            }
          }
        },
        {
          "name": "Create Category (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": {\n    \"en\": \"Solar Panel Servicing\",\n    \"bn\": \"সোলার প্যানেল সার্ভিসিং\"\n  },\n  \"slug\": \"solar-servicing\",\n  \"description\": {\n    \"en\": \"Installation and solar inverter repair in Dhaka\",\n    \"bn\": \"সোলার প্যানেল ও ইনভার্টার মেরামত\"\n  },\n  \"icon\": \"Sun\",\n  \"order\": 11\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "categories"]
            }
          }
        }
      ]
    },
    {
      "name": "05. Services & Search (Phase 3)",
      "item": [
        {
          "name": "List All Services",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/services",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "services"]
            }
          }
        },
        {
          "name": "Search Services (Keyword + Area + Price Range)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/services/search?q=ac&area=mirpur&minPrice=300&maxPrice=3000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "services", "search"],
              "query": [
                { "key": "q", "value": "ac" },
                { "key": "area", "value": "mirpur" },
                { "key": "minPrice", "value": "300" },
                { "key": "maxPrice", "value": "3000" }
              ]
            }
          }
        },
        {
          "name": "Create Service (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": {\n    \"en\": \"AC Gas Refill (R410A / R32)\",\n    \"bn\": \"এসি গ্যাস রিফিল\"\n  },\n  \"slug\": \"ac-gas-refill\",\n  \"category\": \"{{categoryId}}\",\n  \"description\": {\n    \"en\": \"Genuine AC refrigerant gas leak check and full refill\",\n    \"bn\": \"জেনুইন এসি গ্যাস রিফিল ও লিকেজ মেরামত\"\n  },\n  \"basePrice\": 2500,\n  \"pricingType\": \"STARTING_PRICE\",\n  \"estimatedDurationMinutes\": 60\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/services",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "services"]
            }
          }
        }
      ]
    },
    {
      "name": "06. Provider Listings & Discovery (Phase 3)",
      "item": [
        {
          "name": "Create/Update Provider Listing",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"serviceAreas\": [\"mirpur\", \"dhanmondi\", \"gulshan\"],\n  \"experienceYears\": 5,\n  \"customPrice\": 1100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/providers/listings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "providers", "listings"]
            }
          }
        },
        {
          "name": "Get My Provider Listings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/providers/listings/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "providers", "listings", "me"]
            }
          }
        },
        {
          "name": "Discover Providers in Dhaka Area",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/providers?area=mirpur",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "providers"],
              "query": [{ "key": "area", "value": "mirpur" }]
            }
          }
        }
      ]
    }
  ]
}
